# Copy to .env and change every "change-me".

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Set to true once FolkBook runs on HTTPS (SITE_ADDRESS is a domain).
DJANGO_SECURE_COOKIES=false

# Postgres
POSTGRES_DB=folkbook
POSTGRES_USER=folkbook
POSTGRES_PASSWORD=change-me

# Web server (Caddy)
# ":80" serves plain HTTP. Use your domain (e.g. folk.example.com) for automatic HTTPS.
SITE_ADDRESS=:80
# Port on this machine that FolkBook is reachable on.
FOLKBOOK_PORT=8080

# The address people open FolkBook at, for links in emails. Defaults to the first
# DJANGO_CSRF_TRUSTED_ORIGINS.
# FOLKBOOK_URL=https://folk.example.com

# Email (password resets, reminder digests). Either set it up in the app (Settings →
# Email (SMTP), as an admin), or here: then the app shows these and can't change them.
# FOLKBOOK_SMTP_HOST=smtp.example.com
# FOLKBOOK_SMTP_PORT=587
# FOLKBOOK_SMTP_SECURITY=starttls  # starttls, ssl or none
# FOLKBOOK_SMTP_USERNAME=
# FOLKBOOK_SMTP_PASSWORD=
# FOLKBOOK_SMTP_FROM=FolkBook <folkbook@example.com>

# Where the app's "Source code" link points (FolkBook is AGPL). Change it if you run
# a modified FolkBook, so people using your server can get your changes.
# FOLKBOOK_SOURCE_URL=https://github.com/Thnorty/FolkBook
