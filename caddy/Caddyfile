{$SITE_ADDRESS::80} {
	encode zstd gzip

	@backend path /api /api/* /admin /admin/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Django's own static files (the admin), collected by the backend container.
	handle_path /django-static/* {
		root * /srv/django-static
		file_server
	}

	# The React app: serve built files, fall back to index.html for client-side routes.
	handle {
		root * /srv/frontend
		# Built files have a content hash in their names, so they can be kept for good.
		# Everything else (the page, sw.js, the manifest) is checked on every visit,
		# so a new version shows up right away.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
